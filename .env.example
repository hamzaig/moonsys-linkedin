# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Invite code required to create an account; each account chooses its own password
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling MoonSys LinkedIn's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./moonsys-linkdin.db in cwd)
# When running via Docker, this is set automatically to /data/moonsys-linkdin.db
MOONSYS_DB_PATH=

# Set to "false" to show the browser window during automation (useful for debugging)
HEADLESS=true

# Optional verified LinkedIn messaging query override; leave empty for the built-in reference.
LINKEDIN_CONVERSATIONS_QUERY_ID=
